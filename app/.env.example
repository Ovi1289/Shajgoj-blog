# ---------- Server ----------
PORT=3000
# The public URL of this server (product links in Facebook posts point here)
PUBLIC_BASE_URL=https://shop.example.com
# Password for /admin (username can be anything). Leave empty only on your own computer.
ADMIN_PASSWORD=change-me

# ---------- Shop ----------
SHOP_NAME=Shajgoj Shop
SHOP_PHONE=01700000000
SHOP_CURRENCY=৳
BRAND_COLOR=#e91e63

# ---------- AI (Claude) ----------
# From https://platform.claude.com → API keys
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# ---------- Background removal ----------
# Empty = free on-server AI removal. Set a remove.bg key for faster/sharper cutouts.
REMOVE_BG_API_KEY=

# ---------- Facebook ----------
# Leave these empty to run in demo (dry-run) mode: nothing is posted or spent.
FB_PAGE_ID=
# Long-lived Page access token with pages_manage_posts, pages_read_engagement
FB_PAGE_ACCESS_TOKEN=
# Ad account ID (with or without act_)
FB_AD_ACCOUNT_ID=
# System-user / user token with ads_management on that ad account
FB_ADS_ACCESS_TOKEN=
FB_DEFAULT_COUNTRY=BD
# FB_GRAPH_VERSION=v23.0
# Force demo mode even when credentials are set:
# FB_DRY_RUN=true
# FB_ADS_DRY_RUN=true
