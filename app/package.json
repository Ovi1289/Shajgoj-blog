{
  "name": "shajgoj-autopilot",
  "version": "1.0.0",
  "description": "One-stop product → website → creative → Facebook post → ad autopilot",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "check": "for f in src/*.js public/admin/app.js; do node --check $f || exit 1; done"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@imgly/background-removal-node": "^1.4.5",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
